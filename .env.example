# Các giá trị mẫu, không phải secrets thật. PowerShell: $env:NAME='value'
# Dự án không tự nạp .env; đặt biến trong terminal hoặc IntelliJ Run Configuration.
SPRING_PROFILES_ACTIVE=sqlserver
DB_AUTH=sql
PORT=8080
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTE_Burrito;encrypt=true;trustServerCertificate=true
DB_USER=YOUR_SQL_LOGIN
DB_PASSWORD=CHANGE_ME
# Windows Authentication: DB_AUTH=windows, bỏ DB_USER/DB_PASSWORD và dùng:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UTE_Burrito;integratedSecurity=true;authenticationScheme=NativeAuthentication;encrypt=true;trustServerCertificate=true
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BASE_URL=https://YOUR_PUBLIC_HTTPS_DOMAIN
COOKIE_SECURE=true
# Profile sqlserver luôn tắt seed, không dùng SEED_ENABLED.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.com
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
