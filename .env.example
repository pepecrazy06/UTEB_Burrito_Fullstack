# Các giá trị mẫu, không phải secrets thật. PowerShell: $env:NAME='value'
# Lưu một lần bằng .\sql\Save-LocalConfig.ps1 để tạo .env.local.properties riêng trên máy.
# Profile sqlserver tự nạp tệp đó; biến trong terminal/IntelliJ được ưu tiên hơn.
# .env.example chỉ để tham khảo, không được tự nạp.
SPRING_PROFILES_ACTIVE=sqlserver
DB_AUTH=sql
PORT=8080
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=uteb;encrypt=true;trustServerCertificate=true
DB_USER=YOUR_SQL_LOGIN
DB_PASSWORD=CHANGE_ME
# Windows Authentication: DB_AUTH=windows, bỏ DB_USER/DB_PASSWORD và dùng:
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=uteb;integratedSecurity=true;authenticationScheme=NativeAuthentication;encrypt=true;trustServerCertificate=true
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BASE_URL=https://YOUR_PUBLIC_HTTPS_DOMAIN
COOKIE_SECURE=true
# Profile sqlserver luôn tắt seed, không dùng SEED_ENABLED.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Bật MAIL_ENABLED=true sau khi điền đủ SMTP, xem SMTP_SETUP.md.
# MAIL_FROM mặc định dùng SMTP_USER; chỉ đặt nếu nhà cung cấp cho phép địa chỉ khác.
CLOUDINARY_CLOUD=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
